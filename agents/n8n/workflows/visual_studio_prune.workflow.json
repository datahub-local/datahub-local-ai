      {
        "id": "prune-filter-old-assets",
        "name": "filter_old_assets",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          900,
          0
        ],
        "parameters": {
          "jsCode": "// The bucket objects are pruned on the same two-day window as the run rows, so an asset\n// never outlives its record. LastModified is the object's own clock; a listing entry\n// without a parsable one is kept rather than deleted blind.\nconst cutoff = new Date(Date.now() - 2 * 24 * 60 * 60 * 1000).getTime();\nreturn $input.all().filter((i) => {\n  const t = new Date(i.json.LastModified || 0).getTime();\n  return isFinite(t) && t > 0 && t < cutoff;\n}).map((i) => ({ json: { Key: i.json.Key, LastModified: i.json.LastModified } }));\n"
        }
      },
      {
        "id": "prune-delete-assets",
        "name": "delete_assets",
        "type": "n8n-nodes-base.s3",
        "typeVersion": 1,

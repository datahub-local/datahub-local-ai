{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/opencode-go/deepseek-v4.1-flash",
  "update": "disable",
  "enabled_providers": ["litellm"],
  "providers": {
    "litellm": {
      "name": "LiteLLM",
      "env": ["LITELLM_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:LITELLM_BASE_URL}"
      },
      "models": {
        "opencode-go/deepseek-v4.1-flash": {}
      }
    }
  },
  "instructions": ["/opt/opencode/AGENTS.md"],
  "skills": {
    "paths": ["/opt/opencode/skills"]
  },
  "mcp": {
    "servers": {
      "fc": {
        "type": "remote",
        "url": "{env:OPENCODE_FIRECRAWL_MCP_URL}",
        "oauth": false,
        "codemode": false,
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 600000
        }
      },
      "k8s": {
        "type": "remote",
        "url": "{env:OPENCODE_K8S_MCP_URL}",
        "oauth": false,
        "codemode": false,
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 120000
        }
      }
    }
  },
  "permissions": [
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "**/*.env", "effect": "deny" },
    { "action": "read", "resource": "**/*.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/*.pem", "effect": "deny" },
    { "action": "read", "resource": "**/id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "**/id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "**/.netrc", "effect": "deny" },
    { "action": "read", "resource": "**/.kube/**", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "/workspace/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/opt/data/.config/opencode/*", "effect": "allow" },
    { "action": "bash", "resource": "curl *", "effect": "deny" },
    { "action": "bash", "resource": "wget *", "effect": "deny" },
    { "action": "bash", "resource": "git push --force*", "effect": "deny" },
    { "action": "bash", "resource": "git push -f*", "effect": "deny" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "fc_firecrawl_scrape", "resource": "*", "effect": "allow" },
    { "action": "fc_firecrawl_search", "resource": "*", "effect": "allow" },
    { "action": "fc_firecrawl_map", "resource": "*", "effect": "allow" },
    { "action": "k8s_*", "resource": "*", "effect": "allow" }
  ]
}

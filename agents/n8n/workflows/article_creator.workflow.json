      {
        "id": "1ddafc37-25e0-4dd3-bfd8-c93d7c5af347",
        "name": "parse_article",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -16000,
          -992
        ],
        "parameters": {
          "jsCode": "// The two things the caller needs out of the model's answer: the H1, which the row\n// stores as ARTICLE_TITLE and the entry point turns into the frozen slug, and the body,\n// which carries one `<!-- asset:<type> -->` marker per requested asset. The word budget\n// is checked here rather than trusted to the model: a mandatory count in a format is a\n// count that gets invented when the real one is missing, and this is also the change's\n// own acceptance case for an over-budget draft.\n//\n// MAX_WORDS is required. The entry point resolves the row's budget and the 1200 default,\n// so a value missing here is a caller bug: fail loudly rather than guess a bound.\nconst req = $('set_workflow_vars').first().json;\nconst max = Number(req.MAX_WORDS);\nif (!isFinite(max) || max <= 0) throw new Error('MAX_WORDS is required and must be a positive number');\n// An agent node answers `output` where a chain node answered `text`; the sub-workflow's\n// own contract stays the old names, so this is the one place the difference is absorbed.\nconst raw = String($json.output || $json.text || '');\nconst block = /<article>([\\s\\S]*?)<\\/article>/.exec(raw);\nconst inner = (block ? block[1] : raw).trim();\nconst HEAD = /^#\\s+(.+?)\\s*$/;\nlet title = '';\nconst body = [];\nfor (const line of inner.split('\\n')) {\n  if (!title && !body.length && HEAD.test(line.trim())) {\n    title = line.trim().replace(HEAD, '$1');\n    continue;\n  }\n  body.push(line);\n}\nconst text = body.join('\\n').trim();\n// A marker is an instruction to the publishing step, not prose the reader counts.\nconst words = text.replace(/<!--[\\s\\S]*?-->/g, ' ').split(/\\s+/).filter(Boolean).length;\nlet error = '';\nif (!text) error = 'EMPTY_DRAFT: the model returned no article body';\nelse if (!title) error = 'EMPTY_TITLE: the draft has no H1 title';\nelse if (words > max) error = 'OVER_BUDGET: ' + words + ' words against MAX_WORDS=' + max;\nreturn { json: { TITLE: title, TEXT: text, WORD_COUNT: words, ERROR: error } };\n"
        }
      },

      "parameters": {
        "jsCode": "const entry = $('normalize_input').first().json.ENTRY_ID;\nconst rows = $('read_assets').all().map((i) => i.json).filter((r) => r.ENTRY_ID === entry);\nconst approved = rows.find((r) => r.STATUS === 'APPROVED' && r.SPEC_JSON);\nif (approved) {\n  let spec = null;\n  try { spec = JSON.parse(approved.SPEC_JSON); } catch (e) { spec = null; }\n  if (spec) return [{ json: { FROZEN: true, SPEC: spec, SPEC_JSON: approved.SPEC_JSON, ASSET_STATUSES: rows.map((r) => [r.ASSET_TYPE, r.STATUS]) } }];\n}\nreturn [{ json: { FROZEN: false, ASSET_STATUSES: rows.map((r) => [r.ASSET_TYPE, r.STATUS]) } }];"
      }

release_name: datahub-local-ai

sympozium_mcp_servers:
  homelab-facts:
    enabled: true
    image: ghcr.io/datahub-local/mcp-homelab-facts
    tag: main
    toolsPrefix: facts
    timeout: 90
    configMap: mcp-homelab-facts
    garageSecret: mcp-s3-token
    garageTokenKey: GARAGE_ADMIN_TOKEN
    garageUrlKey: GARAGE_ADMIN_URL
    ingressRequestsMetric: traefik_service_requests_total
    ingressServiceLabel: exported_service
    ingressServiceStripPattern: (-[0-9a-f]{16,})?@[a-z]+$

  utils:
    enabled: true
    image: ghcr.io/datahub-local/mcp-utils
    tag: main
    toolsPrefix: utils
    timeout: 130
    observabilityEnv: false
    kubernetesReader: false
    envSecret: mcp-utils-s3

  semantic:
    enabled: true
    image: ghcr.io/datahub-local/mcp-semantic
    tag: main
    toolsPrefix: semantic
    timeout: 60
    configMap: mcp-semantic
    observabilityEnv: false
    kubernetesReader: false
    trinoUrl: http://datahub-local-core-data-trino-trino.data.svc.cluster.local:8080
    trinoUser: mcp
    warehouseScopes: silver.bodega,gold.bodega
    cacheTTLSeconds: 3600

  semantic-finance:
    enabled: true
    server: semantic
    configDir: semantic-finance
    image: ghcr.io/datahub-local/mcp-semantic
    tag: main
    toolsPrefix: finance
    timeout: 60
    configMap: mcp-semantic-finance
    observabilityEnv: false
    kubernetesReader: false
    trinoUrl: http://datahub-local-core-data-trino-trino.data.svc.cluster.local:8080
    trinoUser: mcp
    warehouseScopes: silver.finance,gold.finance
    cacheTTLSeconds: 3600

sympozium_pi_render:
  enabled: true
  image: ghcr.io/datahub-local/datahub-local-ai-pi-render-adapter
  digest: sha256:39214529a3538f20472ede6eadd58bf9a5077a77ee4eed8f2c075154f6591550
  storage: 8Gi
  storageClass: longhorn
  resources:
    requests:
      cpu: 500m
      memory: 2Gi
    limits:
      cpu: "3"
      memory: 6Gi
  model:
    provider: openrouter
    name: opencode-go/deepseek-v4.1-flash
    baseURL: http://datahub-local-core-data-litellm.data.svc.cluster.local:4000/v1
    authSecret: litellm-auth-credentials-pi-render
    namespace: data
    port: 4000

sympozium_pi_writer:
  enabled: true
  image: ghcr.io/datahub-local/datahub-local-ai-pi-writer-adapter
  digest: sha256:66c0254867be2b56f3ee5ea288f8ff01cb96f8c5be1f2c5d21749d58968468c0
  storage: 1Gi
  storageClass: longhorn
  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      cpu: "1"
      memory: 2Gi
  model:
    provider: openrouter
    name: opencode-go/deepseek-v4.1-flash
    baseURL: http://datahub-local-core-data-litellm.data.svc.cluster.local:4000/v1
    authSecret: litellm-auth-credentials-pi-writer
    namespace: data
    port: 4000

sympozium_delivery_hook:
  image: python:3.13-alpine
  secret: mcp-slack-token
  tokenKey: SLACK_BOT_TOKEN

sympozium_delivery:
  homelab-ops:
    channel: "#monitoring-ai-health"

    personas:
      sre-sentinel:
        channel: "#monitoring-ai-alerts"
      gitops-auditor:
        channel: "#monitoring-ai-drift"

  homelab-responder:
    personas:
      homelab-oracle:
        deliveryMode: reply

sympozium_ensembles:
  homelab-ops:
    enabled: true

    agentSandbox:
      enabled: false
      runtimeClass: gvisor

    channelConfigs:
      slack: mcp-slack-token

    baseURL: http://datahub-local-core-data-litellm.data.svc.cluster.local:4000/v1

    authRefs:
      - provider: openrouter
        secret: litellm-auth-credentials-homelab-ops

    policyRef: permissive

  homelab-reviewer:
    enabled: true

    agentSandbox:
      enabled: false
      runtimeClass: gvisor

    baseURL: http://datahub-local-core-data-litellm.data.svc.cluster.local:4000/v1

    authRefs:
      - provider: openrouter
        secret: litellm-auth-credentials-homelab-reviewer

    policyRef: permissive

  homelab-responder:
    enabled: true

    agentSandbox:
      enabled: false
      runtimeClass: gvisor

    channelConfigs:
      slack: mcp-slack-token

    channelAccessControl:
      slack:
        allowedChats:
          - C0CC1563FA5
          - C08S5ACNTPB
          - C0BSUUF6GHE
          - C0BS4BLGU3W
          - C0BRYNSTJHL
          - C0BRWR00SGM

    baseURL: http://datahub-local-core-data-litellm.data.svc.cluster.local:4000/v1

    authRefs:
      - provider: openrouter
        secret: litellm-auth-credentials-homelab-responder

    policyRef: permissive

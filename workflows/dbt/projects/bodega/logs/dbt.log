    create  table
      "silver"."bodega"."invoices__dbt_tmp"
  
    
    as (
      SELECT
    invoice_number,
    strptime(invoice_date, '%Y-%m-%dT%H:%M:%S')                               AS invoice_datetime,
    CAST(strptime(invoice_date, '%Y-%m-%dT%H:%M:%S') AS DATE)                 AS invoice_date,
    year(strptime(invoice_date, '%Y-%m-%dT%H:%M:%S'))                        AS invoice_year,
    month(strptime(invoice_date, '%Y-%m-%dT%H:%M:%S'))                       AS invoice_month,
    week(strptime(invoice_date, '%Y-%m-%dT%H:%M:%S'))                        AS invoice_week,
    operator_id,
    store_vat_id,
    trim(upper(store_name))                                             AS store_name,
    total_amount,
    (
        SELECT SUM(CAST(json_extract_string(e, '$.tax') AS DOUBLE))
        FROM UNNEST(json_extract(taxes_json, '$[*]')) AS u(e)
    )                          AS total_tax_amount,
    (
        SELECT SUM(CAST(json_extract_string(e, '$.base') AS DOUBLE))
        FROM UNNEST(json_extract(taxes_json, '$[*]')) AS u(e)
    )                         AS total_base_amount,
    payment_method,
    card_type,
    card_number_masked,
    supermarket,
    json_array_length(CAST(items_json AS JSON))                                 AS item_count,
    _ingested_at
FROM "bronze"."bodega"."raw_invoices"
    );
    
  

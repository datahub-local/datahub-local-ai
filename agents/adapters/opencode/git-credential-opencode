#!/bin/sh
# git credential helper for the opencode-server container.
#
# Two sources, one contract:
#
#   GITHUB_TOKEN  a token from the deployment's own Secret. This is the interim
#                 path while no GitHub App exists: nothing to mint, and the
#                 credential is dedicated to this workload rather than shared.
#   the minter    when the App is wired (deferred), the sidecar holds the key and
#                 mints an installation token on demand, so a session that has
#                 been running for days still gets a live one.
#
# git calls a helper as `git-credential-opencode <operation>`; only `get` needs an
# answer. The token is never written to disk by this script.
[ "$1" = "get" ] || exit 0

if [ -n "${GITHUB_TOKEN:-}" ]; then
  printf 'username=x-access-token\npassword=%s\n' "$GITHUB_TOKEN"
  exit 0
fi

# `--noproxy` keeps the loopback call out of the egress proxy.
exec curl -fsS --max-time 10 --noproxy '*' http://127.0.0.1:8787/token \
  | jq -r '"username=x-access-token\npassword=" + .token'

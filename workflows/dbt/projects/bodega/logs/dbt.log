    create  table
      "silver"."bodega"."invoice_taxes__dbt_tmp"
  
    
    as (
      SELECT
    b.invoice_number,
    b.supermarket,
    CAST(strptime(b.invoice_date, '%Y-%m-%dT%H:%M:%S') AS DATE)              AS invoice_date,
    json_extract_string(_it.elem, '$.rate')                     AS tax_rate,
    CAST(json_extract_string(_it.elem, '$.base') AS DOUBLE)     AS base_amount,
    CAST(json_extract_string(_it.elem, '$.tax') AS DOUBLE)     AS tax_amount
FROM "bronze"."bodega"."raw_invoices" AS b
CROSS JOIN (
        SELECT json_extract(b.taxes_json, '$[' || g.i || ']') AS elem, g.i + 1 AS pos
        FROM range(CAST(json_array_length(CAST(b.taxes_json AS JSON)) AS BIGINT)) AS g(i)
    ) AS _it
    );
    
  

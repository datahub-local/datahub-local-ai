{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "update": "disable",
  "plugins": [
    "opencode-plugin-litellm@1.8.1"
  ],
  "enabled_providers": [
    "litellm"
  ],
  "instructions": [
    "/opt/opencode/AGENTS.md"
  ],
  "skills": {
    "paths": [
      "/opt/opencode/skills"
    ]
  },
  "compaction": {
    "buffer": "60%"
  },
  "experimental": {
    "background_compaction": true
  },
  "mcp": {
    "servers": {
      "fc": {
        "type": "remote",
        "url": "{env:OPENCODE_FIRECRAWL_MCP_URL}",
        "oauth": false,
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 600000
        }
      },
      "k8s": {
        "type": "remote",
        "url": "{env:OPENCODE_K8S_MCP_URL}",
        "oauth": false,
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 120000
        }
      },
      "n8n": {
        "type": "remote",
        "url": "{env:OPENCODE_N8N_MCP_URL}",
        "headers": {
          "Authorization": "Bearer {env:OPENCODE_N8N_MCP_TOKEN}"
        },
        "oauth": false,
        "timeout": {
          "startup": 30000,
          "catalog": 60000,
          "execution": 300000
        }
      }
    }
  },
  "permissions": [
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/*.pem",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/id_rsa*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/id_ed25519*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.netrc",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "**/.kube/**",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/workspace/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/opt/data/.config/opencode/*",
      "effect": "allow"
    },
    {
      "action": "bash",
      "resource": "curl *",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "wget *",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "git push --force*",
      "effect": "deny"
    },
    {
      "action": "bash",
      "resource": "git push -f*",
      "effect": "deny"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "fc_firecrawl_scrape",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "fc_firecrawl_search",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "fc_firecrawl_map",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "k8s_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "n8n_*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "reviewer": {
      "description": "Reviews a diff before the task is reported done: correctness, scope, test quality, and the rules the repository states. Read-only.",
      "mode": "subagent",
      "model": "{env:OPENCODE_REVIEW_MODEL}",
      "system": "You review a change you did not write. Read the issue, then `git diff <base>...HEAD`. Findings, most severe first: BLOCKING (correctness, a gate that does not pass, a behaviour change with no test that can fail, a contradiction with AGENTS.md or an OpenSpec spec, a secret or a destructive command); SHOULD (missing test, rule stated twice, diff wider than the issue); NIT. One line each: `path:line`, what is wrong, the smallest fix. Quote only the offending line. No preamble, no restating the diff. Mark inference `[UNVERIFIED]`. If nothing is wrong, say so in one line. End with `VERDICT: approve` or `VERDICT: changes-required`, and at most five findings.",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "task",
          "resource": "*",
          "effect": "deny"
        }
      ],
      "steps": 25
    }
  }
}

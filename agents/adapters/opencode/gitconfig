# Installed as /etc/gitconfig, the system-wide file git reads before any user or
# repository config. It must not live under $HOME: the state volume is mounted
# over /opt/data and would hide a baked file.
[credential]
	# Resolved through PATH as /usr/local/bin/git-credential-opencode.
	helper = git-credential-opencode
[user]
	# The coder App's bot identity: GitHub links a commit to the bot only when the
	# email is <app-id>+<slug>[bot]@users.noreply.github.com.
	name = datahub-local-coder[bot]
	email = 5570821+datahub-local-coder[bot]@users.noreply.github.com
[init]
	defaultBranch = main

#!/usr/bin/env python3
"""Tunnel an SSH connection through the egress proxy's HTTP CONNECT port.

SSH has no equivalent of HTTPS_PROXY, and the agent's NetworkPolicy allows only the
Squid proxy on 3128, so an SSH remote (github over 443) needs a CONNECT tunnel.
Passed to ssh as `ProxyCommand /usr/local/bin/ssh-proxy-command %h %p`.

Without HTTPS_PROXY it behaves as a plain TCP connection, so the same ssh_config
works inside and outside the cluster.
"""

from __future__ import annotations

import base64
import os
import socket
import sys
import threading
from urllib.parse import urlsplit


def _configured_proxy() -> str | None:
    for name in ("HTTPS_PROXY", "https_proxy", "HTTP_PROXY", "http_proxy"):
        value = os.environ.get(name)
        if value:
            return value
    return None


def _connect(host: str, port: int) -> socket.socket:
    proxy = _configured_proxy()
    if not proxy:
        return socket.create_connection((host, port), timeout=30)

    parsed = urlsplit(proxy if "://" in proxy else f"http://{proxy}")
    sock = socket.create_connection(
        (parsed.hostname or "127.0.0.1", parsed.port or 3128), timeout=30
    )
    request = f"CONNECT {host}:{port} HTTP/1.1\r\nHost: {host}:{port}\r\n"
    if parsed.username:
        credentials = f"{parsed.username}:{parsed.password or ''}".encode()
        request += f"Proxy-Authorization: Basic {base64.b64encode(credentials).decode()}\r\n"
    request += "\r\n"
    sock.sendall(request.encode())

    response = b""
    while b"\r\n\r\n" not in response:
        chunk = sock.recv(4096)
        if not chunk:
            break
        response += chunk
    if not response.startswith((b"HTTP/1.1 200", b"HTTP/1.0 200")):
        sys.stderr.write(response.decode(errors="replace").strip() + "\n")
        raise SystemExit(1)

    sock.settimeout(None)
    return sock


def _pump_from_stdin(sock: socket.socket) -> None:
    while True:
        data = os.read(0, 65536)
        if not data:
            break
        sock.sendall(data)
    try:
        sock.shutdown(socket.SHUT_WR)
    except OSError:
        pass


def main() -> None:
    if len(sys.argv) != 3:
        raise SystemExit("usage: ssh-proxy-command <host> <port>")
    sock = _connect(sys.argv[1], int(sys.argv[2]))
    threading.Thread(target=_pump_from_stdin, args=(sock,), daemon=True).start()
    while True:
        data = sock.recv(65536)
        if not data:
            break
        os.write(1, data)


if __name__ == "__main__":
    main()

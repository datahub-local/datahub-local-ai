    create  table
      "silver"."bodega"."stores__dbt_tmp"
  
    
    as (
      
WITH ranked AS (
    SELECT
        store_vat_id,
        store_name,
        store_address,
        store_phone,
        supermarket,
        CAST(strptime(invoice_date, '%Y-%m-%dT%H:%M:%S') AS DATE)                     AS invoice_date,
        ROW_NUMBER() OVER (
            PARTITION BY store_vat_id
            ORDER BY strptime(invoice_date, '%Y-%m-%dT%H:%M:%S') DESC, invoice_number DESC
        )                                                                       AS rn
    FROM "bronze"."bodega"."raw_invoices"
)

SELECT
    ranked.store_vat_id                                                         AS store_id,
    trim(upper(ranked.store_name))                                              AS name,
    ranked.store_vat_id                                                         AS vat_id,
    ranked.store_address                                                        AS address,
    ranked.store_phone                                                          AS phone,
    ranked.supermarket,
    seen.first_seen_date,
    seen.last_seen_date
FROM ranked
JOIN (
    SELECT
        store_vat_id,
        MIN(invoice_date)                                                       AS first_seen_date,
        MAX(invoice_date)                                                       AS last_seen_date
    FROM ranked
    GROUP BY store_vat_id
) AS seen ON seen.store_vat_id = ranked.store_vat_id
WHERE ranked.rn = 1
    );
    
  
[0m17:32:50.664261 [debug] [Thread-1 (]: On model.bodega.invoice_items: /* {"app": "dbt", "dbt_version": "1.12.3", "profile_name": "bodega", "target_name": "local", "node_id": "model.bodega.invoice_items"} */

    

    create  table
      "silver"."bodega"."invoice_items__dbt_tmp"
  
    
    as (
      SELECT
    b.invoice_number,
    CAST(_it.pos AS INTEGER)                                                       AS item_position,
    CAST(strptime(b.invoice_date, '%Y-%m-%dT%H:%M:%S') AS DATE)                          AS invoice_date,
    b.store_vat_id,
    b.supermarket,
    json_extract_string(_it.elem, '$.description')                          AS description_raw,
    trim(upper(json_extract_string(_it.elem, '$.description')))             AS description_clean,
    CAST(json_extract_string(_it.elem, '$.quantity') AS DOUBLE)             AS quantity,
    CASE
        WHEN CAST(json_extract_string(_it.elem, '$.quantity') AS DOUBLE)
             != FLOOR(CAST(json_extract_string(_it.elem, '$.quantity') AS DOUBLE))
        THEN 'KG' ELSE 'EA'
    END                                                                            AS unit,
    CAST(json_extract_string(_it.elem, '$.unit_price') AS DOUBLE)           AS unit_price,
    CAST(json_extract_string(_it.elem, '$.total') AS DOUBLE)                AS total_amount
FROM "bronze"."bodega"."raw_invoices" AS b
CROSS JOIN (
        SELECT json_extract(b.items_json, '$[' || g.i || ']') AS elem, g.i + 1 AS pos
        FROM range(CAST(json_array_length(CAST(b.items_json AS JSON)) AS BIGINT)) AS g(i)
    ) AS _it
    );
    
  

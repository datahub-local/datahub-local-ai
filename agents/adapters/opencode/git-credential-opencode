#!/bin/sh
# git credential helper for the opencode-server container.
#
# The token is not a file and not an environment variable: the minter sidecar
# holds the GitHub App key, mints an installation token, and keeps it in memory.
# This helper asks the loopback endpoint every time git needs a credential, so a
# session that has been running for days still gets a live token.
#
# git calls a helper as `git-credential-opencode <operation>`; only `get` needs
# an answer. `--noproxy` keeps the loopback call out of the egress proxy.
[ "$1" = "get" ] || exit 0

exec curl -fsS --max-time 10 --noproxy '*' http://127.0.0.1:8787/token \
  | jq -r '"username=x-access-token\npassword=" + .token'

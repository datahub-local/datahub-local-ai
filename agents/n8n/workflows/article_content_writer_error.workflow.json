      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -144
      ],
      "parameters": {
        "jsCode": "// The row the failed run claimed, matched by the execution id the entry point wrote\n// when it claimed it. When nothing matches, one item still leaves here carrying\n// NO_ROW, because otherwise the Sheet update, the Slack notice and the whole error\n// path would each run zero times and the failure would be invisible -- which is the\n// class of bug this workflow exists for: n8n logs no line at all for a failed\n// execution at log_level info, so nobody would ever hear about it.\nconst wfId = String($('set_workflow_vars').first().json.workflowId || '');\nconst rows = $input.all().map((i) => i.json);\nconst hit = rows.find((r) => String(r.EXECUTION_ID || '').trim() === wfId) || null;\nif (hit) return [{ json: Object.assign({}, hit, { NO_ROW: false }) }];\nconsole.warn('no article_queue row carries EXECUTION_ID ' + wfId);\nreturn [{ json: { NO_ROW: true, row_number: '', ENTRY_ID: '', TOPIC: '' } }];\n"
      }
    },

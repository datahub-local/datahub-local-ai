      {
        "parameters": {
          "jsCode": "const regexList = [\n  /property=[\"']og:image[\"'][^>]*content=[\"']([^\"']+)[\"']/i,\n  /content=[\"']([^\"']+)[\"'][^>]*property=[\"']og:image[\"']/i\n]\n\nvar ogImageUrl = null;\n\nfor (const item of $input.all()) {\n  const body = item.json.original_body || item.json.body;\n\n  for (const regex of regexList) {\n    const match = body.match(regex);\n\n    if (match){\n      ogImageUrl = match[1];\n    \n      item.json.ogImageUrl = ogImageUrl;\n      break;\n    }\n  }\n  \n}\n\nreturn $input.all();"
        },

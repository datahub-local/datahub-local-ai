      "id": "afb4ac58-7bf3-4dbf-a25e-6e0cc4800309",
      "name": "normalize_input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const i = $input.first().json;\nconst str = (v) => String(v == null ? '' : v);\nconst types = str(i.ASSET_TYPES).trim();\nconst text = str(i.ARTICLE_TEXT).trim();\nif (!str(i.ENTRY_ID).trim()) throw new Error('ENTRY_ID is required');\nif (!text) throw new Error('ARTICLE_TEXT is required');\nreturn [{ json: {\n  ENTRY_ID: str(i.ENTRY_ID).trim(),\n  ARTICLE_TEXT: text,\n  ASSET_TYPES: types,\n  FEEDBACK: str(i.FEEDBACK).trim(),\n} }];"
      }
    },

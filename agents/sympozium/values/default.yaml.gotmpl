# Per-cluster knobs only. Rationale for every one of them lives in ../MEMORY.md.
release_name: datahub-local-ai

sympozium_mcp_servers:
  homelab-facts:
    enabled: true
    image: ghcr.io/datahub-local/datahub-local-ai-mcp
    tag: main

sympozium_delivery_hook:
  image: curlimages/curl:8.11.1
  secret: mcp-slack-token
  tokenKey: SLACK_BOT_TOKEN

sympozium_delivery:
  homelab-ops:
    channel: "#monitoring-ai-health"

    personas:
      sre-sentinel:
        channel: "#monitoring-ai-alerts"
      gitops-auditor:
        channel: "#monitoring-ai-drift"

  homelab-responder:
    personas:
      homelab-oracle:
        deliveryMode: reply

sympozium_ensembles:
  homelab-ops:
    enabled: true

    channelConfigs:
      slack: mcp-slack-token

    baseURL: http://datahub-local-core-data-ollama.data.svc:11434/v1

    policyRef: permissive

  homelab-reviewer:
    enabled: true
    
    baseURL: http://datahub-local-core-data-ollama.data.svc:11434/v1
    
    policyRef: permissive

  homelab-responder:
    enabled: true

    channelConfigs:
      slack: mcp-slack-token

    baseURL: http://datahub-local-core-data-ollama.data.svc:11434/v1

    policyRef: permissive

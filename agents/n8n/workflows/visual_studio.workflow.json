    {
      "id": "86a95901-9012-4958-900f-f6c00fd34d84",
      "name": "merge_assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        0
      ],
      "parameters": {
        "jsCode": "const esc = (s) => String(s).replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\nconst escAttr = (s) => esc(s).replace(/\"/g, \"&quot;\");\nfunction buildMarkup(tmpl, spec, fps, frames, viewport, isSvg) {\n  const accent = /^#[0-9a-fA-F]{6}$/.test(spec.accent || \"\") ? spec.accent : \"#22d3ee\";\n  const kind = [\"rise\", \"fade\", \"sweep\", \"pulse\"].includes(spec.motion && spec.motion.kind)\n    ? spec.motion.kind : \"rise\";\n  const duration = Math.max(1000, Math.min(4000, (spec.motion && spec.motion.durationMs) || 3000));\n  const blocks = (spec.blocks || []).slice(0, 6);\n  const step = Math.floor(duration / (blocks.length + 1));\n  let out;\n  if (isSvg) {\n    const top = 360, row = 150;\n    const svgBlocks = blocks.map((b, i) => {\n      const delay = i * step, d = Math.max(200, duration - delay), y = top + i * row;\n      return `<g class=\"block\" style=\"animation-delay:${delay}ms;animation-duration:${d}ms\">` +\n        `<text class=\"label\" x=\"64\" y=\"${y}\">${esc(b.label)}</text>` +\n        `<text class=\"value\" x=\"1136\" y=\"${y}\" text-anchor=\"end\">${esc(b.value)}</text>` +\n        `<line class=\"sep\" x1=\"64\" y1=\"${y + 28}\" x2=\"1136\" y2=\"${y + 28}\" /></g>`;\n    }).join(\"\\n  \");\n    out = tmpl.split(\"%%TITLE%%\").join(esc(spec.title || \"\"))\n      .split(\"%%BLOCKS%%\").join(svgBlocks).split(\"%%ACCENT%%\").join(accent)\n      .split(\"%%MOTION_ANIM%%\").join(kind).split(\"%%DURATION_MS%%\").join(String(duration))\n      .split(\"%%FPS%%\").join(String(fps)).split(\"%%FRAMES%%\").join(String(frames))\n      .split(\"%%VIEWPORT%%\").join(String(viewport)).split(\"%%ALT%%\").join(escAttr(spec.alt || \"\"));\n  } else {\n    const htmlBlocks = blocks.map((b, i) => {\n      const delay = i * step, d = Math.max(200, duration - delay);\n      return `<div class=\"block\" style=\"animation-delay:${delay}ms;animation-duration:${d}ms\">` +\n        `<span class=\"label\">${esc(b.label)}</span><span class=\"value\">${esc(b.value)}</span></div>`;\n    }).join(\"\\n      \");\n    out = tmpl.split(\"%%TITLE%%\").join(esc(spec.title || \"\"))\n      .split(\"%%BLOCKS%%\").join(htmlBlocks).split(\"%%ACCENT%%\").join(accent)\n      .split(\"%%MOTION_ANIM%%\").join(kind).split(\"%%DURATION_MS%%\").join(String(duration))\n      .split(\"%%FPS%%\").join(String(fps)).split(\"%%FRAMES%%\").join(String(frames))\n      .split(\"%%VIEWPORT%%\").join(String(viewport));\n  }\n  const left = out.match(/%%[A-Z_]+%%/g);\n  if (left) throw new Error(\"unresolved template token(s): \" + left.join(\", \"));\n  return out;\n}\nconst specItem = $('spec_ready').first();\nconst spec = specItem.json.SPEC;\nconst specJson = specItem.json.SPEC_JSON;\nconst htmlT = $('download_html_template').first().json.output;\nconst svgT = $('download_svg_template').first().json.output;\nconst base = (a) => ({\n  ENTRY_ID: a.ENTRY_ID, ASSET_ID: a.ENTRY_ID + ':' + a.ASSET_TYPE,\n  ASSET_TYPE: a.ASSET_TYPE, RENDER_MODE: a.RENDER_MODE || '',\n  FORMAT: a.FORMAT || '', ROUND: '0', FEEDBACK: a.FEEDBACK || '',\n  SPEC_JSON: '', PROMPT: '', DURATION_MS: '', FRAME_COUNT: '', WIDTH: '', HEIGHT: '',\n  ERROR: '', STATUS: 'PENDING', UPDATE_DATE: new Date().toISOString(),\n});\nconst out = [];\nfor (const item of $('parse_registry').all()) {\n  const a = item.json;\n  const row = base(a);\n  if (a.STATUS === 'UNKNOWN' || a.STATUS === 'SKIPPED') {\n    row.STATUS = a.STATUS; row.ERROR = a.ERROR || '';\n  } else if (a.AVAILABLE === false) {\n    row.STATUS = 'UNAVAILABLE';\n    row.ERROR = a.UNAVAILABLE_REASON || ('unavailable: ' + a.ASSET_TYPE);\n  } else {\n    row.SPEC_JSON = specJson;\n  }\n  let markup = '', markupKind = '';\n  const prior = $('read_assets').all().map((i) => i.json).find((r) => r.ASSET_ID === row.ASSET_ID);\n  if (prior && prior.STATUS === 'APPROVED') { row.STATUS = 'APPROVED'; row.ROUND = prior.ROUND || row.ROUND; }\n  if (a.AVAILABLE !== false && a.STATUS !== 'UNKNOWN' && a.STATUS !== 'SKIPPED' && a.AUTHOR === 'spec_markup') {\n    if (a.RENDER_MODE === 'animated') { markup = buildMarkup(htmlT, spec, a.FPS, a.FRAMES, a.VIEWPORT, false); markupKind = 'html'; }\n    else if (a.RENDER_MODE === 'text') { markup = buildMarkup(svgT, spec, a.FPS, a.FRAMES, a.VIEWPORT, true); markupKind = 'svg'; }\n  }\n  out.push({ json: Object.assign({}, a, { SPEC: spec, SPEC_JSON: specJson, MARKUP: markup, MARKUP_KIND: markupKind, row } ) });\n}\nreturn out;"
      }
    },

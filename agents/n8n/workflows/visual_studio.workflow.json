    {
      "id": "ee273689-ada8-4668-b0b5-e6b9c58f1182",
      "name": "parse_registry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const cfg = JSON.parse($('download_registry').first().json.output || '{}');\nconst req = $('normalize_input').first().json;\nconst types = Array.isArray(cfg.types) ? cfg.types : [];\nconst byId = new Map(types.map((t) => [t.id, t]));\nconst budget = cfg.budget || {};\nconst cap = Number(cfg.max_types_per_article || 3);\nlet requested = req.ASSET_TYPES\n  ? req.ASSET_TYPES.split(',').map((s) => s.trim()).filter(Boolean)\n  : (cfg.default_types || []);\n// The static hero is always produced (spec requirement), and is first.\nif (!requested.includes('hero_static')) requested.unshift('hero_static');\n// Deduplicate, preserving order.\nrequested = [...new Set(requested)];\nconst notes = [];\nconst unknown = requested.filter((id) => !byId.has(id));\nunknown.forEach((id) => notes.push({ ASSET_TYPE: id, STATUS: 'UNKNOWN',\n  ERROR: 'unknown asset type: ' + id }));\nrequested = requested.filter((id) => byId.has(id));\n// Cap, hero first.\nconst capped = requested.slice(0, cap);\nrequested.slice(cap).forEach((id) => notes.push({ ASSET_TYPE: id, STATUS: 'SKIPPED',\n  ERROR: 'over the per-article cap of ' + cap }));\nconst out = [];\nfor (const id of capped) {\n  const t = byId.get(id);\n  const b = Object.assign({}, budget, t.budget || {});\n  out.push({ json: Object.assign({}, req, {\n    ASSET_TYPE: t.id,\n    NAME: t.name || t.id,\n    AUTHOR: t.author,\n    TEMPLATE: t.template || null,\n    SPEC_TEMPLATE: t.specTemplate || null,\n    RENDER_MODE: t.render,\n    FORMAT: t.format,\n    FALLBACK_FORMAT: t.fallbackFormat || null,\n    ASPECT: t.aspect || '4:5',\n    AVAILABLE: t.available !== false,\n    UNAVAILABLE_REASON: t.unavailableReason || '',\n    FPS: Number(b.fps || 12),\n    FRAMES: Number(b.frames || 36),\n    VIEWPORT: Number(b.viewport || 1200),\n    CAP: cap,\n  }) });\n}\nfor (const n of notes) out.push({ json: Object.assign({}, req, n, { AVAILABLE: false }) });\nreturn out;"
      }
    },
    {

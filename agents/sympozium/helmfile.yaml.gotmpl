---
environments:
  default:
    values:
      - values/default.yaml.gotmpl
---
helmDefaults:
  wait: true
  timeout: 600
  recreatePods: false
  force: false

commonLabels:
  provider: "{{ .Values.release_name }}-helm"

releases:
  - name: "{{ .Values.release_name }}-sympozium"
    # Must be the namespace the Sympozium controller watches — the same one the
    # control plane and the MCPServer catalog live in (see datahub-local-core,
    # releases/automation/values/sympozium.yaml.gotmpl).
    namespace: automation
    chart: "."
    values:
      - values/default.yaml.gotmpl

# Per-cluster knobs only. Rationale for every one of them lives in ../MEMORY.md.
release_name: datahub-local-ai

# The repo-local MCP servers. Only the facts server lives here; core owns the
# shared catalog (k8s, github, argocd, grafana, postgres) and this chart never
# re-declares any of it. Built from ../mcp/ — see that README for why the
# gathering moved out of the model.
sympozium_mcp_servers:
  homelab-facts:
    enabled: true
    image: ghcr.io/datahub-local/datahub-local-ai-mcp
    tag: main

sympozium_delivery_hook:
  image: curlimages/curl:8.11.1
  secret: mcp-slack-token
  tokenKey: SLACK_BOT_TOKEN

sympozium_delivery:
  homelab-ops:
    channel: "#monitoring-ai-health"

    personas:
      sre-sentinel:
        channel: "#monitoring-ai-alerts"
      gitops-auditor:
        channel: "#monitoring-ai-drift"

sympozium_web_endpoint:
  enabled: false

  ensembles:
    homelab-ops:
      enabled: true
      requestsPerMinute: 60
      burstSize: 10

    homelab-reviewer:
      enabled: false

sympozium_ensembles:
  homelab-ops:
    enabled: true

    channelConfigs:
      slack: mcp-slack-token

    baseURL: http://datahub-local-core-data-ollama.data.svc:11434/v1

    policyRef: permissive

  homelab-reviewer:
    enabled: true
    baseURL: http://datahub-local-core-data-ollama.data.svc:11434/v1
    policyRef: permissive

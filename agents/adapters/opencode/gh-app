#!/bin/sh
# `gh` has no credential helper; the git helper does, and both must present the
# same identity. Call the helper binary directly, never `git credential fill`:
# git reads its config again there, and a `gh auth setup-git` line left in a
# persisted home points that config back at this wrapper, so the two recurse.
helper=git-credential-opencode

# git calls this wrapper directly when such a line survives. Answer in git's
# protocol instead of spawning gh again.
if [ "$1" = "auth" ] && [ "$2" = "git-credential" ]; then
  exec "$helper" get
fi

if [ -z "${GH_TOKEN:-}" ] && [ -z "${GITHUB_TOKEN:-}" ]; then
  token=$("$helper" get | sed -n 's/^password=//p')
  [ -n "$token" ] && export GH_TOKEN="$token"
fi
exec gh-real "$@"

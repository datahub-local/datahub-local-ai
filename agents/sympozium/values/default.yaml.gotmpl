# Per-cluster knobs only. Rationale for every one of them lives in ../MEMORY.md.
release_name: datahub-local-ai

sympozium_mcp_servers:
  homelab-facts:
    enabled: true
    image: ghcr.io/datahub-local/datahub-local-ai-mcp
    tag: main
    # Per-bucket S3 size has no unauthenticated source; see ../MEMORY.md. The
    # Secret must exist in THIS namespace - a secretKeyRef cannot cross one, and
    # core provisions garage-credentials into `data` only. The ref is optional,
    # so until it is replicated here the bucket section reports itself
    # unavailable and nothing else is affected.
    garageSecret: mcp-s3-token
    garageTokenKey: GARAGE_ADMIN_TOKEN
    garageUrlKey: GARAGE_ADMIN_URL

sympozium_delivery_hook:
  image: python:3.13-alpine
  secret: mcp-slack-token
  tokenKey: SLACK_BOT_TOKEN

sympozium_delivery:
  homelab-ops:
    channel: "#monitoring-ai-health"

    personas:
      sre-sentinel:
        channel: "#monitoring-ai-alerts"
      gitops-auditor:
        channel: "#monitoring-ai-drift"

  homelab-responder:
    personas:
      homelab-oracle:
        deliveryMode: reply

sympozium_ensembles:
  homelab-ops:
    enabled: true

    agentSandbox:
      enabled: false
      runtimeClass: gvisor

    channelConfigs:
      slack: mcp-slack-token

    baseURL: http://datahub-local-core-data-ollama.data.svc:11434/v1

    policyRef: permissive

  homelab-reviewer:
    enabled: true

    agentSandbox:
      enabled: false
      runtimeClass: gvisor

    baseURL: http://datahub-local-core-data-ollama.data.svc:11434/v1
    
    policyRef: permissive

  homelab-responder:
    enabled: true

    agentSandbox:
      enabled: false
      runtimeClass: gvisor

    channelConfigs:
      slack: mcp-slack-token

    # Who may start a run, which is a different question from how they reach the
    # agent: slackOptions.allowedTriggers gates the *kind* of message (mention,
    # dm) and never the sender. With this unset, anyone in the workspace who can
    # @-mention the bot gets a run holding the facts server, k8s_pods_log and
    # send_channel_message. Inbound-only, so it cannot affect the reporters.
    # A Slack *user id*, not an @handle - the handle is not what the API sends.
    channelAccessControl:
      slack:
        allowedSenders:
          - U08RV08387L
        # Set, so a refusal is visible. Empty means rejected messages are dropped
        # in silence and read as the agent being broken.
        denyMessage: >-
          This agent only answers its operator. Nothing was run.

    baseURL: http://datahub-local-core-data-ollama.data.svc:11434/v1

    policyRef: permissive
